{
  "name": "convertisseur",
  "version": "2.9.0",
  "description": "Convertisseur de devises",
  "private": true,
  "scripts": {
    "sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-www.ps1 -Android",
    "sync:www": "powershell -ExecutionPolicy Bypass -File scripts/sync-www.ps1",
    "build:apk": "npm run sync && cd android && .\\gradlew.bat assembleDebug",
    "build:apk:beta": "powershell -ExecutionPolicy Bypass -File scripts/build-beta.ps1",
    "keystore": "powershell -ExecutionPolicy Bypass -File scripts/create-keystore.ps1",
    "build:release": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
